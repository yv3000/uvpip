# uvpip environment variable reference.
#
# Documentation template only: uvpip and its installers never read a .env file.
# Export the variables you need in your shell (or CI job) instead. Real .env
# files are gitignored; never commit credentials or machine-specific paths.
# Every variable is optional; empty or unset means "use the default".

# --- Runtime (read by the uvpip binary on every invocation) ---

# Absolute path to the uv executable to run (overrides PATH and discovery).
UVPIP_UV=

# Set to 1/true to enable structured stderr diagnostics (key=value telemetry).
UVPIP_DEBUG=

# Passed to uv; defaults to 1 outside venv/Conda to mirror pip system targeting.
UV_SYSTEM_PYTHON=

# Path to a local uvpip binary to install instead of downloading from release.
UVPIP_BINARY=

# Expected SHA-256 hex digest of candidate binary to assert during installation.
UVPIP_SHA256=

# Set to 1 to skip modifying shell profiles during POSIX installation/removal.
UVPIP_NO_PROFILE=

