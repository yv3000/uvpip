# uvpip environment variable reference.
#
# Documentation template only: uvpip and its installers never read a .env file.
# Export the variables you need in your shell (or CI job) instead. Real .env
# files are gitignored; never commit credentials or machine-specific paths.
# Every variable is optional; empty or unset means "use the default".

# --- Runtime (read by the uvpip binary on every invocation) ---

# Absolute path to the uv executable to run. Relative paths are rejected, and an
# invalid value fails instead of falling back to PATH. Default: search PATH, then
# known per-user install locations.
UVPIP_UV=

# Set to 1, true, yes, or on to print structured key=value diagnostics (uv path,
# discovery source, environment decision, exit code, duration) to stderr.
# Argument values and environment contents are never logged. Default: off.
UVPIP_DEBUG=

# uv's own setting, passed through unchanged. If unset and neither VIRTUAL_ENV nor
# CONDA_PREFIX is non-empty, uvpip sets UV_SYSTEM_PYTHON=1 to mirror pip's
# behavior of targeting the system interpreter. Set to false to opt out.
UV_SYSTEM_PYTHON=

# --- uv discovery fallbacks (read by the uvpip binary; normally set by the OS) ---
# Used only when UVPIP_UV is unset and uv is not on PATH. Relative values are ignored.

# Home directory (HOME on macOS/Linux, USERPROFILE on Windows). uvpip checks
# <home>/.local/bin/uv and <home>/.cargo/bin/uv.
HOME=
USERPROFILE=

# Windows only. uvpip checks %APPDATA%\astral\uv\bin\uv.exe and
# %LOCALAPPDATA%\Programs\uv\uv.exe.
APPDATA=
LOCALAPPDATA=

# --- Installers (read only by installer/install.sh and installer/install.ps1) ---

# Path to a local uvpip binary to install instead of downloading the latest
# published release. install.ps1 also accepts it as -BinaryPath.
UVPIP_BINARY=

# Expected SHA-256 hex digest of the binary being installed. When set, a
# mismatch aborts installation. install.ps1 also accepts it as -SHA256.
UVPIP_SHA256=

# --- Installers and uninstallers (POSIX sh only) ---

# Set to 1 to skip adding/removing the marked shell profile block. PowerShell
# scripts use the -NoProfile switch instead.
UVPIP_NO_PROFILE=
